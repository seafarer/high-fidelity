---
import { Image } from "astro:assets";
import headshot from "../assets/colin-7.jpg";
---

<section id="about" class="pt-30 pb-32.5">
  <div class="mx-auto grid max-w-page items-start gap-18 px-8 md:grid-cols-[7fr_5fr]">
    <div>
      <div class="label text-pink-deep">$whoami</div>
      <h2 class="mt-3.5 mb-9 font-display text-[clamp(44px,6vw,72px)] leading-[1.05] font-normal uppercase">
        High Fidelity means <span
          class="hl -rotate-2 border-3 border-ink bg-violet text-paper shadow-[6px_6px_0_var(--color-pink)]"
          >no static</span
        >
      </h2>
      <div class="flex max-w-140 flex-col gap-4.5 text-[17px] leading-[1.65] text-pretty text-ink-800">
        <p>I’m Colin O’Brien, a senior web engineer and technical lead based on the Western Slope of Colorado.</p>
        <p>I grew up wanting to be an architect. Once I discovered the internet and digital publishing I learned that I could design and build homes for products and stories. Like architecture, my goal is to create things that are both useful and beautiful.</p>
        <p>I'm happy whether leading projects or contributing a specific role. You can bring me in at the beginning or airdrop me in midstream, hand me requirements or just tell me the challenge and be assured that your work will be delivered with the highest of fidelity.</p> 
        <p>With over twenty years of experience designing, building and shipping with agencies, as a freelancer and on the product side, I am currently available for your next project.</p>
      </div>
    </div>
    <div class="flex justify-center md:pt-30">
      <div
        class="relative w-[min(100%,380px)] rotate-1 border-3 border-ink bg-card px-4 pt-5 pb-5 shadow-[18px_18px_0_var(--color-pink)]"
      >
        <span
          class="absolute -top-4.5 left-1/2 -ml-15 h-8 w-30 -rotate-5 border-2 border-ink bg-sun opacity-95"
          aria-hidden="true"></span>
        <svg class="absolute size-0" aria-hidden="true">
          <filter id="duotone" color-interpolation-filters="sRGB">
            <feColorMatrix type="saturate" values="0" result="gray" />
            <feComponentTransfer in="gray" result="tone">
              <feFuncR type="table" tableValues="0.086 0.353 0.847 0.953" />
              <feFuncG type="table" tableValues="0.075 0.247 0.816 0.933" />
              <feFuncB type="table" tableValues="0.114 0.941 1 0.89" />
            </feComponentTransfer>
            <feComposite in="tone" in2="gray" operator="arithmetic" k2="0.3" k3="0.7" />
          </filter>
        </svg>
        <Image
          src={headshot}
          alt="Colin O'Brien"
          width={334}
          height={334}
          class="block aspect-square w-full border-3 border-ink object-cover [filter:url(#duotone)]"
        />
        <div class="mt-4 flex items-center justify-between gap-3">
          <span class="label tracking-[.14em]">Colin O'Brien</span>
          <div class="flex gap-2.5">
            <a
              href="https://www.linkedin.com/in/colinobrien1/"
              target="_blank"
              rel="noreferrer"
              aria-label="Colin O'Brien on LinkedIn"
              class="grid size-9 place-items-center border-2 border-ink bg-sun font-mono text-xs font-bold text-ink shadow-[3px_3px_0_var(--color-ink)]"
              >in</a
            >
            <a
              href="https://github.com/seafarer/"
              target="_blank"
              rel="noreferrer"
              aria-label="Colin O'Brien on GitHub"
              class="grid size-9 place-items-center border-2 border-ink bg-violet font-mono text-xs font-bold text-paper shadow-[3px_3px_0_var(--color-ink)]"
              >gh</a
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
