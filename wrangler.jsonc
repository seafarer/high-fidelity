{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "high-fidelity",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve dist/404.html with a 404 status for unknown paths.
    "not_found_handling": "404-page",
    // Only the form endpoint runs Worker code; everything else is served as a static asset.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CONTACT_TO": "info@highfidelity.dev",
    "CONTACT_FROM": "High Fidelity <contact@highfidelity.dev>"
  },
  // RESEND_API_KEY is a secret: `npx wrangler secret put RESEND_API_KEY`, or .dev.vars locally.
  "observability": { "enabled": true }
}
