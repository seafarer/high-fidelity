---

<section class="dots-light pt-27.5 pb-22.5">
  <div class="mx-auto grid max-w-(--container-page) items-start gap-10 px-8 md:grid-cols-3 md:gap-24">
    <div class="border-t-4 border-ink pt-4.5">
      <div
        class="inline-block font-display text-[clamp(84px,10vw,128px)] leading-[.9] text-violet [text-shadow:5px_5px_0_var(--color-pink)]"
      >
        20+
      </div>
      <div class="label mt-4.5">Years on the web</div>
      <div class="mt-1.5 text-[15px] text-ink-600">Build, product, and publishing</div>
    </div>
    <div class="border-t-4 border-ink pt-4.5 md:mt-16">
      <div
        class="relative inline-block font-display text-[clamp(84px,10vw,128px)] leading-[.9] text-pink [text-shadow:5px_5px_0_var(--color-ink)]"
      >
        76<span class="text-[.7em]">%</span>
        <span
          class="absolute top-0 left-full -ml-3 rotate-[8deg] border-2 border-ink bg-violet px-2.25 py-1.25 font-mono text-[11px] leading-snug font-bold tracking-widest whitespace-nowrap text-paper uppercase [text-shadow:none]"
          >4 clients<br />15+ yrs</span
        >
      </div>
      <div class="label mt-4.5">Clients who stay</div>
      <div class="mt-1.5 text-[15px] text-ink-600">19 of 25 since 2022 still active</div>
    </div>
    <div class="border-t-4 border-ink pt-4.5 md:mt-6">
      <div
        class="inline-block font-display text-[clamp(84px,10vw,128px)] leading-[.9] text-ink [text-shadow:5px_5px_0_var(--color-sun)]"
      >
        −30<span class="text-[.7em]">%</span>
      </div>
      <div class="label mt-4.5">Under budget</div>
      <div class="mt-1.5 text-[15px] text-ink-600">Drupal → WordPress, 25K posts intact</div>
    </div>
  </div>
</section>
