---
const year = new Date().getFullYear();

const navItems = [
  { href: "/#work", label: "Work" },
  { href: "/#lab", label: "Lab" },
  { href: "/#about", label: "About" },
  { href: "/#contact", label: "Contact" },
];
---

<footer class="overflow-hidden bg-ink pt-10 pb-9 text-paper">
  <div class="mx-auto max-w-(--container-page) px-8">
    <div
      class="-rotate-2 text-center font-display text-[clamp(64px,15vw,200px)] leading-[.9] whitespace-nowrap text-[#2b2536] uppercase"
      aria-hidden="true"
    >
      High Fidelity
    </div>
    <div
      class="label mt-12 flex flex-wrap items-center justify-between gap-6 border-t-3 border-night-line pt-6 text-[11px] tracking-[.14em]"
    >
      <span class="text-fog-dim">© {year} Colin O'Brien · Colorado, USA</span>
      <div class="flex flex-wrap gap-6">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
    </div>
  </div>
</footer>
