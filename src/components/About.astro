---
import { Image } from "astro:assets";
import headshot from "../assets/headshot.png";
---

<section id="about" class="pt-30 pb-32.5">
  <div class="mx-auto grid max-w-(--container-page) items-start gap-18 px-8 md:grid-cols-2">
    <div>
      <div class="label text-pink-deep">About · 20 years in</div>
      <h2 class="mt-3.5 mb-9 font-display text-[clamp(44px,6vw,72px)] leading-[1.05] font-normal uppercase">
        The person behind <span
          class="hl -rotate-2 border-3 border-ink bg-violet text-paper shadow-[6px_6px_0_var(--color-pink)]"
          >the platforms</span
        >
      </h2>
      <div class="flex max-w-140 flex-col gap-4.5 text-[17px] leading-[1.65] text-pretty text-ink-800">
        <p>I'm Colin O'Brien — an independent senior web engineer and technical lead based in Colorado.</p>
        <p>
          I've worked across development, product, UX, publishing, and digital strategy for more than 20 years.
          Before returning to independent consulting, I led engineering and product work for Outside's publishing
          platform and later co-founded Wild Roar, a small digital studio.
        </p>
        <p>
          I'm happiest on projects that are a little messy: legacy systems, complicated migrations, ambitious new
          products, or situations where the technical problem is only part of the actual problem.
        </p>
        <p>
          I work directly with companies and also partner with agencies that need additional senior engineering
          capacity.
        </p>
      </div>
    </div>
    <div class="flex justify-center md:pt-30">
      <div
        class="relative w-[min(100%,380px)] -rotate-2 border-3 border-ink bg-card px-4 pt-5 pb-5 shadow-[18px_18px_0_var(--color-pink)]"
      >
        <span
          class="absolute -top-4.5 left-1/2 -ml-15 h-8 w-30 -rotate-5 border-2 border-ink bg-sun opacity-95"
          aria-hidden="true"></span>
        <Image
          src={headshot}
          alt="Colin O'Brien"
          width={334}
          height={334}
          class="block aspect-square w-full border-3 border-ink object-cover contrast-105 grayscale"
        />
        <div class="mt-4 flex items-center justify-between gap-3">
          <span class="label tracking-[.14em]">Colin O'Brien · CO</span>
          <div class="flex gap-2.5">
            <a
              href="https://www.linkedin.com/in/colinobrien1/"
              target="_blank"
              rel="noreferrer"
              aria-label="Colin O'Brien on LinkedIn"
              class="grid size-9 place-items-center border-2 border-ink bg-sun font-mono text-xs font-bold text-ink shadow-[3px_3px_0_var(--color-ink)]"
              >in</a
            >
            <a
              href="https://github.com/seafarer/"
              target="_blank"
              rel="noreferrer"
              aria-label="Colin O'Brien on GitHub"
              class="grid size-9 place-items-center border-2 border-ink bg-violet font-mono text-xs font-bold text-paper shadow-[3px_3px_0_var(--color-ink)]"
              >gh</a
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
