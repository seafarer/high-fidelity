---
import Contact from "./Contact";
---

<section id="contact" class="border-t border-primary-100">
  <div class="mx-auto grid max-w-(--container-page) gap-12 px-6 py-20 md:grid-cols-5 md:py-28">
    <div class="md:col-span-2">
      <h2 class="font-display text-3xl text-ink md:text-4xl">Have a complicated web problem?</h2>
      <p class="mt-4 max-w-md text-primary-800">
        I'm available for fractional technical leadership, senior contract engineering, migrations, platform
        modernization, and select web builds.
      </p>
      <dl class="mt-8 space-y-3 text-primary-800">
        <div class="flex items-center gap-3">
          <dt class="sr-only">Email</dt>
          <dd>
            <a href="mailto:info@highfidelity.dev" class="font-semibold text-ink hover:text-secondary-600">
              info@highfidelity.dev
            </a>
          </dd>
        </div>
        <div class="flex items-center gap-3">
          <dt class="sr-only">Phone</dt>
          <dd>+1 (970) 404-0988</dd>
        </div>
      </dl>
    </div>
    <div class="rounded-2xl border border-primary-200 bg-white p-6 md:col-span-3 md:p-8">
      <Contact client:load />
    </div>
  </div>
</section>
