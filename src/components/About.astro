---
import { Image } from "astro:assets";
import profilePic from "../assets/profile-pic.jpg";
import Linkedin from "./icons/Linkedin.astro";
import Github from "./icons/Github.astro";
---

<section id="about" class="mx-auto max-w-(--container-page) px-6 py-20 md:py-28">
  <div class="grid gap-10 md:grid-cols-[1fr_auto] md:items-start md:gap-16">
    <div>
      <h2 class="font-display text-3xl text-ink md:text-4xl">About</h2>
      <div class="mt-6 max-w-2xl space-y-4 text-lg text-primary-900">
        <p>
          I'm Colin O'Brien, an independent senior web engineer and technical lead based in Colorado.
        </p>
        <p>
          I've worked across development, product, UX, publishing, and digital strategy for more than 20 years.
          Before returning to independent consulting, I led engineering and product work for Outside's publishing
          platform and later co-founded Wild Roar, a small digital studio.
        </p>
        <p>
          I'm happiest working on projects that are a little messy: legacy systems, complicated migrations,
          ambitious new products, or situations where the technical problem is only part of the actual problem.
        </p>
        <p>
          I work directly with companies and also partner with agencies that need additional senior engineering
          capacity.
        </p>
      </div>
    </div>
    <div
      class="flex flex-col items-center gap-4 rounded-2xl border border-primary-200 border-t-4 border-t-secondary-500 bg-white p-6"
    >
      <Image
        src={profilePic}
        alt="Colin O'Brien"
        width={200}
        height={200}
        class="rounded-2xl object-cover"
      />
      <div class="flex gap-4">
        <a
          href="https://www.linkedin.com/in/colinobrien1/"
          target="_blank"
          rel="noreferrer"
          class="text-primary-500 hover:text-secondary-600"
        >
          <span class="sr-only">Colin O'Brien on LinkedIn</span>
          <Linkedin width={22} />
        </a>
        <a
          href="https://github.com/seafarer/"
          target="_blank"
          rel="noreferrer"
          class="text-primary-500 hover:text-secondary-600"
        >
          <span class="sr-only">Colin O'Brien on GitHub</span>
          <Github width={22} />
        </a>
      </div>
    </div>
  </div>
</section>
