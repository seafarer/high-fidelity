---
import Github from "./icons/Github.astro";
import Linkedin from "./icons/Linkedin.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-primary-100">
  <div class="mx-auto flex max-w-(--container-page) flex-col gap-4 px-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-primary-800">&copy; {year} Colin O'Brien. Based in Colorado.</p>
    <div class="flex items-center gap-5">
      <a
        href="https://www.linkedin.com/in/colinobrien1/"
        target="_blank"
        rel="noreferrer"
        class="text-primary-500 transition-colors hover:text-secondary-600"
      >
        <span class="sr-only">Colin O'Brien on LinkedIn</span>
        <Linkedin width={20} />
      </a>
      <a
        href="https://github.com/seafarer/"
        target="_blank"
        rel="noreferrer"
        class="text-primary-500 transition-colors hover:text-secondary-600"
      >
        <span class="sr-only">Colin O'Brien on GitHub</span>
        <Github width={20} />
      </a>
      <a href="mailto:info@highfidelity.dev" class="text-sm font-semibold text-primary-800 hover:text-secondary-600">
        info@highfidelity.dev
      </a>
    </div>
  </div>
</footer>
