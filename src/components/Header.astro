---
import HfLogo from "./icons/HfLogo.astro";

const navItems = [
  { href: "/work", label: "Work" },
  { href: "/lab", label: "Lab" },
  { href: "/#about", label: "About" },
  { href: "/#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-30 border-b border-primary-100 bg-paper/90 backdrop-blur">
  <div class="mx-auto flex max-w-(--container-page) items-center justify-between gap-6 px-6 py-4">
    <a href="/" class="flex items-center gap-3 text-ink">
      <HfLogo width={28} class="text-primary-500" />
      <span class="font-display text-xl tracking-wide">High Fidelity</span>
    </a>
    <nav>
      <ul class="flex flex-wrap items-center gap-6 text-sm font-semibold tracking-wide text-ink">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="transition-colors hover:text-secondary-600">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
