---
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"lab">;
  index?: number;
}

const badgeColors = {
  note: "bg-sun text-ink",
  article: "bg-violet text-paper",
  app: "bg-pink text-ink",
  github: "bg-ink text-paper",
};

const { entry, index = 0 } = Astro.props;
const { title, description, tags, type, date } = entry.data;
const formattedDate = date.toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
---

<a
  href={`/lab/${entry.id}`}
  class="block-shadow lift relative block border-3 border-ink bg-card px-[30px] pt-8 pb-7 hover:text-ink [--o:12px] hover:[--sc:var(--color-pink)]"
>
  <span
    class={`label absolute -top-3.5 right-[22px] border-2 border-ink px-2.5 py-1 text-[11px] tracking-[.14em] ${badgeColors[type]} ${index % 2 ? "-rotate-4" : "rotate-4"}`}
  >
    {type}
  </span>
  <div class="label text-[11px] tracking-[.14em] text-ink-500">{formattedDate}</div>
  <h3 class="mt-2.5 mb-2.5 font-display text-[26px] leading-[1.1] font-normal uppercase">{title}</h3>
  <p class="text-[15px] leading-relaxed text-ink-700">{description}</p>
  {
    tags.length > 0 && (
      <div class="label mt-[18px] flex flex-wrap gap-2 text-[10px] tracking-[.12em]">
        {tags.map((tag) => (
          <span class="border-2 border-ink px-2 py-1">{tag}</span>
        ))}
      </div>
    )
  }
</a>
