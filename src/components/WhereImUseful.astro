---
const items = [
  {
    kicker: "Migrations",
    title: "Platform modernization & migrations",
    body: "Untangling aging CMSs, consolidating platforms, migrating content, rebuilding frontends, and getting difficult web systems onto maintainable foundations.",
    card: "md:col-span-6 bg-card [--sc:var(--color-pink)]",
    kickerColor: "text-violet",
    bodyColor: "text-ink-700 max-w-130",
    badge: "rotate-4 bg-sun text-ink",
  },
  {
    kicker: "Engineering",
    title: "Senior engineering",
    body: "Hands-on development for WordPress, React, Next.js, Astro, TypeScript, and headless architectures. Embedded with your team or developing your project.",
    card: "md:col-span-6 md:mt-9 rotate-1 bg-violet text-paper [--sc:var(--color-pink)]",
    kickerColor: "text-sun",
    bodyColor: "",
    badge: "-rotate-5 bg-pink text-ink",
  },
  {
    kicker: "Leadership",
    title: "Fractional technical leadership",
    body: "Architecture, technical planning, system audits, vendor and team coordination, code review, platform ownership, and getting ambiguous projects moving.",
    card: "md:col-span-5 md:-mt-2 rotate-1 bg-sun [--sc:var(--color-ink)]",
    kickerColor: "text-ink",
    bodyColor: "text-ink-800",
    badge: "rotate-3 bg-violet text-paper",
  },
  {
    kicker: "Product",
    title: "Product & experience design",
    body: "Product discovery, user interviews, UX and interface design, prototyping, and analytics. Defining the problem and shaping the experience before building it.",
    card: "md:col-span-7 md:mt-7 bg-pink [--sc:var(--color-violet)]",
    kickerColor: "text-ink",
    bodyColor: "text-ink max-w-130",
    badge: "-rotate-4 bg-sun text-ink",
  },
];
---

<section class="pt-15 pb-30">
  <div class="mx-auto max-w-page px-8">
    <div class="label text-pink-deep">Capabilities</div>
    <h2 class="mt-3.5 mb-14 font-display text-[clamp(44px,6vw,72px)] leading-none font-normal uppercase">
      Where I'm <span class="hl -rotate-3 border-3 border-ink bg-sun shadow-[6px_6px_0_var(--color-pink)]">useful</span>
    </h2>
    <div class="grid gap-10 md:grid-cols-12 md:gap-7">
      {
        items.map((item, i) => (
          <div class={`block-shadow lift relative flex flex-col items-start justify-center border-3 border-ink p-7.5 [--o:12px] ${item.card}`}>
            <div class={`label tracking-[.14em] ${item.kickerColor}`}>{item.kicker}</div>
            <span
              class={`absolute -top-5.5 right-6 grid size-15 place-items-center border-3 border-ink font-display text-[28px] shadow-[5px_5px_0_var(--color-ink)] ${item.badge}`}
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-3.5 mb-3 font-display text-3xl leading-[1.05] font-normal uppercase">{item.title}</h3>
            <p class={`text-base leading-relaxed text-pretty ${item.bodyColor}`}>{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
