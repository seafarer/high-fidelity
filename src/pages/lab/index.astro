---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LabCard from "../../components/LabCard.astro";

const entries = (await getCollection("lab")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Lab" description="Small tools, prototypes, experiments, and technical notes.">
  <section class="dots-sand bg-sand pt-24 pb-32.5">
    <div class="mx-auto max-w-(--container-page) px-8">
      <div class="label text-pink-deep">Explorations</div>
      <h1 class="mt-3.5 font-display text-[clamp(56px,7vw,96px)] leading-none font-normal uppercase">
        The <span class="hl -rotate-3 border-3 border-ink bg-pink shadow-[6px_6px_0_var(--color-violet)]">lab</span>
      </h1>
      <p class="mt-8 mb-16 max-w-130 text-[17px] leading-relaxed text-pretty text-ink-700">
        Small tools, prototypes, experiments, and technical notes. I use downtime to build things, explore new
        approaches, and test ideas before they show up in client work.
      </p>
      <div class="grid items-stretch gap-9 md:grid-cols-2">
        {entries.map((entry, i) => <LabCard entry={entry} index={i} />)}
      </div>
    </div>
  </section>
</BaseLayout>
