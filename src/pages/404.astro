---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404: Not Found">
  <div class="flex min-h-[60vh] flex-col items-center justify-center px-6 text-center">
    <h1 class="font-display text-3xl text-ink">404: Not Found</h1>
    <p class="mt-4 text-primary-800">This page doesn't exist.</p>
    <a href="/" class="mt-6 text-secondary-600 underline hover:no-underline">Head back to home</a>
  </div>
</BaseLayout>
