---
import Contact from "./Contact";
---

<section id="contact" class="bg-ink pt-[120px] pb-[100px] text-paper">
  <div class="mx-auto grid max-w-(--container-page) items-start gap-[72px] px-8 md:grid-cols-2">
    <div>
      <div class="label text-pink">Contact · Replies within 2 days</div>
      <h2 class="mt-3.5 mb-7 font-display text-[clamp(48px,6.4vw,84px)] leading-[1.05] font-normal uppercase">
        Have a<br /><span
          class="hl -rotate-[2.5deg] bg-pink text-ink shadow-[7px_7px_0_var(--color-sun)]">complicated</span
        > web problem?
      </h2>
      <p class="mb-9 max-w-[440px] text-[17px] leading-relaxed text-pretty text-fog">
        I'm available for fractional technical leadership, senior contract engineering, migrations, platform
        modernization, and select web builds.
      </p>
      <div class="flex flex-col items-start gap-[18px]">
        <a
          href="mailto:info@highfidelity.dev"
          class="-rotate-[1.5deg] border-3 border-ink bg-card px-[18px] py-3 font-mono text-sm font-bold text-ink shadow-[8px_8px_0_var(--color-violet)] outline-3 outline-paper hover:text-ink"
        >
          info@highfidelity.dev
        </a>
        <span class="label mt-2 tracking-[.14em] text-fog">+1 (970) 404-0988 · Mountain time</span>
      </div>
    </div>
    <div
      class="border-3 border-ink bg-card p-8 text-ink shadow-[18px_18px_0_var(--color-pink)] outline-3 outline-paper md:mt-10"
    >
      <Contact client:load />
    </div>
  </div>
</section>
