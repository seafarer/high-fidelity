---
import { getCollection } from "astro:content";
import LabCard from "./LabCard.astro";

const entries = (await getCollection("lab"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<section class="dot-grid border-y border-primary-100 bg-primary-50/40">
  <div class="mx-auto max-w-(--container-page) px-6 py-20 md:py-28">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="font-display text-3xl text-ink md:text-4xl">Lab</h2>
      <a href="/lab" class="text-sm font-semibold text-ink hover:text-secondary-600">See all &rarr;</a>
    </div>
    <p class="mt-4 max-w-2xl text-primary-800">
      Small tools, prototypes, experiments, and technical notes. I use downtime to build things, explore new
      approaches, and test ideas before they show up in client work.
    </p>
    <div class="mt-8 grid gap-5">
      {entries.map((entry) => <LabCard entry={entry} />)}
    </div>
  </div>
</section>
