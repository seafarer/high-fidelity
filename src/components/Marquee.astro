---
interface Props {
  items?: string[];
}

const defaultItems = [
  "WordPress",
  "Next.js",
  "Astro",
  "TypeScript",
  "React",
  "Drupal",
  "Sanity",
  "PHP",
  "Node.js",
  "Platform migrations",
  "Headless CMS",
];

const { items = defaultItems } = Astro.props;

// The track loops by sliding one copy of the list out of view, so each copy must be wider
// than the screen. Repeat short lists until they're about as long as the default, and
// scale the duration to match so every marquee moves at the same speed.
const length = (list: string[]) => list.reduce((sum, item) => sum + item.length + 4, 0);
const repeats = Math.max(1, Math.ceil(length(defaultItems) / length(items)));
const run = Array.from({ length: repeats }, () => items).flat();
const duration = (40 * length(run)) / length(defaultItems);
---

<div
  class="relative z-2 -mt-11 ml-[-2%] w-[104%] rotate-[-1.6deg] overflow-hidden border-y-3 border-ink bg-sun py-3.5 shadow-[0_8px_0_var(--color-pink)]"
>
  <p class="sr-only">{items.join(", ")}</p>
  <div class="animate-marquee flex w-max" style={`animation-duration: ${duration}s`} aria-hidden="true">
    {
      [0, 1].map(() =>
        run.map((item, i) => (
          <span class="inline-flex items-center gap-7 pr-7 font-display text-[26px] tracking-[.02em] whitespace-nowrap text-ink uppercase">
            {item}
            <span class:list={["text-[22px]", i % 2 ? "text-violet" : "text-pink"]}>✱</span>
          </span>
        )),
      )
    }
  </div>
</div>
