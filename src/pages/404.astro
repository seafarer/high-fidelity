---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404: Not Found">
  <section class="dots-light flex min-h-[60vh] flex-col items-center justify-center px-8 py-24 text-center">
    <h1 class="font-display text-[clamp(56px,10vw,128px)] leading-none font-normal uppercase">
      <span class="hl -rotate-3 border-3 border-ink bg-sun shadow-[7px_7px_0_var(--color-pink)]">404</span>
    </h1>
    <p class="mt-8 text-lg text-ink-700">This page doesn't exist.</p>
    <a
      href="/"
      class="btn block-shadow press mt-10 border-ink bg-pink text-ink hover:text-ink [--o:8px] [--sc:var(--color-violet)]"
    >
      Head back home →
    </a>
  </section>
</BaseLayout>
