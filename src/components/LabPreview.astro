---
import { getCollection } from "astro:content";
import LabCard from "./LabCard.astro";

// Featured entries first, newest first within each group.
const entries = (await getCollection("lab"))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

<section id="lab" class="dots-sand border-b-3 border-ink bg-sand pt-27.5 pb-32.5">
  <div class="mx-auto max-w-(--container-page) px-8">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <div class="label text-pink-deep">Explorations</div>
        <h2 class="mt-3.5 font-display text-[clamp(44px,6vw,72px)] leading-none font-normal uppercase">
          The <span class="hl -rotate-3 border-3 border-ink bg-pink shadow-[6px_6px_0_var(--color-violet)]">lab</span>
        </h2>
      </div>
      <a href="/lab" class="label border-b-3 border-pink pb-1 tracking-[.14em]">See all →</a>
    </div>
    <p class="mt-6 mb-14 max-w-130 text-[17px] leading-relaxed text-pretty text-ink-700">
      Small tools, prototypes, experiments, and technical notes. I use downtime to build things, explore new
      approaches, and test ideas before they show up in client work.
    </p>
    <div class="grid items-stretch gap-9 md:grid-cols-2">
      {entries.map((entry, i) => <LabCard entry={entry} index={i} />)}
    </div>
  </div>
</section>
