---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Gallery from "../../components/Gallery.astro";
import { breadcrumbs, ids, ref } from "../../lib/site";
import { shareImage } from "../../lib/share-image";

export async function getStaticPaths() {
  const entries = await getCollection("work");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, summary, client, year, tags, metrics, images, videos } = entry.data;
const { Content } = await render(entry);

// Share image: first screenshot, else the first video poster, else the site default.
const posters = videos.flatMap((video) => (video.poster ? [{ src: video.poster, alt: video.title }] : []));
const image = await shareImage(images.length > 0 ? images : posters);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = [
  {
    "@type": "Article",
    headline: title,
    description: summary,
    author: ref(ids.person),
    publisher: ref(ids.business),
    mainEntityOfPage: pageUrl,
    keywords: tags.join(", "),
    ...(client && { about: { "@type": "Organization", name: client } }),
    ...(image && { image: new URL(image.url, Astro.site).href }),
  },
  breadcrumbs([
    { name: "Home", path: "/" },
    { name: "Work", path: "/work/" },
    { name: title, path: Astro.url.pathname },
  ]),
];
---

<BaseLayout title={title} description={summary} image={image} type="article" jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-8 pt-24 pb-32.5">
    <a href="/work" class="label border-b-3 border-pink pb-1 tracking-[.14em]">&larr; All work</a>
    <h1 class="mt-10 font-display text-[clamp(44px,6vw,72px)] leading-[1.05] font-normal uppercase">{title}</h1>
    <p class="mt-6 border-b-4 border-ink pb-8 text-[clamp(22px,2.6vw,27px)] leading-[1.35] font-medium text-pretty text-ink">{summary}</p>
    <dl class="label flex flex-wrap gap-x-8 gap-y-3 border-b-3 border-ink py-4 text-[11px] tracking-[.14em]">
      {client && (
        <div class="flex gap-2">
          <dt class="text-pink-deep">Client</dt>
          <dd>{client}</dd>
        </div>
      )}
      {year && (
        <div class="flex gap-2">
          <dt class="text-pink-deep">Year</dt>
          <dd>{year}</dd>
        </div>
      )}
      {metrics.length > 0 && (
        <div class="flex gap-2">
          <dt class="text-pink-deep">Impact</dt>
          <dd>{metrics.join(" · ")}</dd>
        </div>
      )}
    </dl>
    <div class="prose-hf mt-10">
      <Content />
    </div>
    {(images.length > 0 || videos.length > 0) && (
      <div class="mt-14 lg:-mx-32">
        <Gallery images={images} videos={videos} />
      </div>
    )}
    {tags.length > 0 && (
        <div class="label mt-12 flex flex-wrap gap-2 text-[10px] tracking-[.12em]">
          {tags.map((tag) => (
            <span class="border-2 border-ink px-2 py-1">{tag}</span>
          ))}
        </div>
      )}
  </article>
</BaseLayout>
