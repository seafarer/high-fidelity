---
import { getCollection } from "astro:content";
import WorkCard from "./WorkCard.astro";

const entries = (await getCollection("work", ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<section id="work" class="border-t-3 border-ink bg-ink pt-27.5 pb-32.5 text-paper">
  <div class="mx-auto max-w-(--container-page) px-8">
    <div class="mb-15 flex flex-wrap items-end justify-between gap-6">
      <div>
        <div class="label text-pink">Case studies · 2019–2024</div>
        <h2 class="mt-3.5 font-display text-[clamp(44px,6vw,72px)] leading-none font-normal uppercase">
          Selected <span class="hl rotate-[2.5deg] border-3 border-paper bg-violet shadow-[6px_6px_0_var(--color-pink)]">work</span>
        </h2>
      </div>
      <a href="/work" class="label border-b-3 border-pink pb-1 tracking-[.14em]">See all →</a>
    </div>
    <div class="flex flex-col gap-9">
      {entries.map((entry, i) => <WorkCard entry={entry} index={i} />)}
    </div>
  </div>
</section>
